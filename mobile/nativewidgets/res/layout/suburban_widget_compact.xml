<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
 <FrameLayout android:id="@+id/widget_canvas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center">
 <ImageView android:id="@+id/widget_scene" android:layout_width="wrap_content" android:layout_height="wrap_content" android:scaleType="fitXY" />
 <FrameLayout android:id="@+id/widget_start_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_start" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="start" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_unlock_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_unlock" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="unlock" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_lock_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_lock" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="lock" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_weather_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_weather" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="weather" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_background_previous_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_background_previous" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="background previous" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_background_next_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_background_next" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="background next" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_style_previous_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_style_previous" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="style previous" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_style_next_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_style_next" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="style next" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_status_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="status" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_map_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_map" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="map" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_recenter_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_recenter" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="recenter" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_settings_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="settings" /></FrameLayout>
 <FrameLayout android:id="@+id/widget_attribution_frame" android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/widget_attribution" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="Map data attribution. Open Suburbanista to read data sources." /></FrameLayout>
 </FrameLayout>
</FrameLayout>
